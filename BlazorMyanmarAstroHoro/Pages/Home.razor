@page "/"
@inject AstroDataService AstroService
@inject CityDirectoryService CityDirectory
@inject SavedHoroscopeService SavedHoroscopes
@inject IJSRuntime JS

<PageTitle>Myanmar Astro Horo — Horoscope Calculator</PageTitle>

<p class="ui-breadcrumb no-print">Burma Project Ideas <span>/</span> Myanmar Astro Horo</p>
<div class="ui-heading no-print"><div><span class="pb-label">Traditional knowledge, thoughtfully presented.</span><h1>Discover your <br /><span class="pb-highlight">horoscope.</span></h1><p>Explore the traditional Myanmar system through your birth date, time, and place.</p></div><span class="ui-badge">Surya Siddhanta</span></div>
<div class="astro-start">
<!-- Input Form Card -->
<div id="astro-form" class="astro-form no-print">
    <div class="rounded-lg border border-border bg-card text-card-foreground shadow-lg">
        <div class="flex flex-col space-y-1.5 p-6 pb-4">
            <h2 class="font-zodiac text-2xl font-semibold leading-none tracking-tight flex items-center gap-2">
                <i class="fa-regular fa-calendar text-primary"></i>
                Horoscope Input
            </h2>
            <p class="text-sm text-muted-foreground">Enter the date, time, and location to calculate the horoscope.</p>
        </div>
        <div class="p-6 pt-0 space-y-6">
            <!-- Name Row -->
            <div>
                <label class="text-sm font-medium leading-none text-muted-foreground mb-2 block">
                    <i class="fa-regular fa-user mr-1"></i> Name
                </label>
                <input type="text" aria-label="Name" @bind="inputModel.Name" placeholder="Enter name"
                       class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
            </div>

            <!-- Date Row -->
            <div>
                <label class="text-sm font-medium leading-none text-muted-foreground mb-2 block">
                    <i class="fa-regular fa-calendar-days mr-1"></i> Date
                </label>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Year</label>
                        <input type="number" aria-label="Year" @bind="inputModel.Year" min="1" max="3000"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Month</label>
                        <select aria-label="Month" @bind="inputModel.Month"
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Day</label>
                        <input type="number" aria-label="Day" @bind="inputModel.Day" min="1" max="31"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                </div>
            </div>

            <!-- Time Row -->
            <div>
                <label class="text-sm font-medium leading-none text-muted-foreground mb-2 block">
                    <i class="fa-regular fa-clock mr-1"></i> Time
                </label>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Hour (0-23)</label>
                        <input type="number" aria-label="Hour" @bind="inputModel.Hour" min="0" max="23"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Minute (0-59)</label>
                        <input type="number" aria-label="Minute" @bind="inputModel.Minute" min="0" max="59"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                </div>
            </div>

            <!-- Location Row -->
            <div>
                <label class="text-sm font-medium leading-none text-muted-foreground mb-2 block">
                    <i class="fa-solid fa-location-dot mr-1"></i> Location
                </label>
                <div class="astro-location-grid grid grid-cols-3 gap-3">
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">City</label>
                        <select aria-label="City" @bind="SelectedCity"
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
                            <optgroup label="Myanmar quick locations">
                            <option value="Yangon">Yangon</option>
                            <option value="Mandalay">Mandalay</option>
                            <option value="Naypyidaw">Naypyidaw</option>
                            <option value="Bagan">Bagan</option>
                            <option value="Taunggyi">Taunggyi</option>
                            <option value="Mawlamyine">Mawlamyine</option>
                            <option value="Custom">Custom</option>
                            </optgroup>
                            <optgroup label="Legacy city directory (1,152 cities)">
                                @foreach (var city in legacyCities)
                                {
                                    <option value="@city.Id">@city.Name, @city.Country</option>
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Latitude</label>
                        <input type="number" step="0.0001" aria-label="Latitude" @bind="inputModel.Latitude"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                    <div>
                        <label class="text-xs text-muted-foreground mb-1 block">Longitude</label>
                        <input type="number" step="0.0001" aria-label="Longitude" @bind="inputModel.Longitude"
                               class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2" />
                    </div>
                </div>
                <label class="mt-3 flex items-center gap-2 text-sm text-muted-foreground cursor-pointer">
                    <input type="checkbox" @bind="inputModel.IsLocalMeanTime"
                           class="h-4 w-4 rounded border-input text-primary focus:ring-ring" />
                    Use local mean time (longitude-based) instead of Myanmar Standard Time (UTC+6:30)
                </label>
            </div>
        </div>

        <!-- Calculate Button -->
        <div class="flex items-center p-6 pt-0">
            <button @onclick="CalculateHoroscope" disabled="@isCalculating"
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground hover:bg-primary/90 h-11 px-8 w-full gap-2 shadow-md hover:shadow-lg">
                @if (isCalculating)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <span>Calculating...</span>
                }
                else
                {
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Calculate Horoscope</span>
                }
            </button>
        </div>
        @if (savedRecords.Count > 0)
        {
            <div class="mx-6 mb-6 rounded-md border border-border bg-muted/10 p-4">
                <label class="mb-2 block text-sm font-medium"><i class="fa-regular fa-folder-open mr-1 text-primary"></i> သိမ်းထားသော ဇာတာများ</label>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <select aria-label="Saved horoscope" @bind="selectedRecordId" class="h-10 flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm">
                        <option value="">ဇာတာတစ်ခုရွေးပါ</option>
                        @foreach (var record in savedRecords)
                        {
                            <option value="@record.Id">@SavedLabel(record)</option>
                        }
                    </select>
                    <button @onclick="LoadSaved" disabled="@string.IsNullOrEmpty(selectedRecordId)" class="rounded-md border border-border px-3 py-2 text-sm hover:bg-muted disabled:opacity-50">ဖွင့်ရန်</button>
                    <button @onclick="DeleteSaved" disabled="@string.IsNullOrEmpty(selectedRecordId)" class="rounded-md border border-border px-3 py-2 text-sm text-destructive hover:bg-destructive/10 disabled:opacity-50">ဖျက်ရန်</button>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(calculationError))
        {
            <div role="alert" class="mx-6 mb-6 rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                @calculationError
            </div>
        }
    </div>
</div>

<aside class="astro-guide no-print"><div class="astro-guide-mark" aria-hidden="true">ဇ</div><span class="ui-badge">A closer look at your chart</span><h2>Start with the details. <br />Explore the bigger picture.</h2><p>Enter a birth date and location to calculate planetary positions and traditional chart divisions.</p><ol><li><b>01</b><span><strong>Birth details</strong><small>A date and time to work from.</small></span></li><li><b>02</b><span><strong>A place in the world</strong><small>Choose from 1,152 cities or enter coordinates.</small></span></li><li><b>03</b><span><strong>Your chart, explained</strong><small>Rasi, Navamsa, Dasa periods, and calendar tables.</small></span></li></ol><p class="ui-note">A traditional reference for learning and reflection. Calculations have not been fully verified against the legacy VB6 app.</p></aside>
</div>
<!-- Results Section -->
@if (result != null)
{
    <div class="astro-results mx-auto mt-10 space-y-6">
        <!-- Result Header -->
        <div class="text-center mb-6">
            <h2 class="font-zodiac text-3xl font-bold text-primary flex items-center justify-center gap-2">
                <i class="fa-solid fa-sun"></i>
                Horoscope Results
                <i class="fa-solid fa-moon"></i>
            </h2>
            <p class="text-muted-foreground text-sm mt-1">@inputModel.Name · @result.SummaryTable.FirstOrDefault(s => s.Label == "နေ့")?.Value · @result.SummaryTable.FirstOrDefault(s => s.Label == "နေရာ")?.Value</p>
            <button @onclick="PrintResults" class="no-print mt-3 inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground hover:bg-muted" title="Print or save as PDF">
                <i class="fa-solid fa-print"></i> ပုံနှိပ် / PDF သိမ်းရန်
            </button>
            <button @onclick="SaveCurrent" class="no-print mt-3 ml-2 inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground hover:bg-muted">
                <i class="fa-regular fa-floppy-disk"></i> ဇာတာသိမ်းရန်
            </button>
        </div>

        <!-- 13-Row Summary / Zata Charts Split -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Panel: 13-Row Summary (VB6 Style) -->
            <div class="lg:col-span-5 rounded-lg border border-border bg-card text-card-foreground shadow-sm">
                <div class="p-4 border-b border-border bg-muted/20">
                    <h3 class="font-semibold text-sm flex items-center gap-2">
                        <i class="fa-solid fa-list-ul text-primary"></i>
                        Astrological Summary
                    </h3>
                </div>
                <div class="p-4">
                    <div class="space-y-1.5 text-sm">
                        @foreach(var row in result.SummaryTable)
                        {
                            <div class="flex justify-between py-1 border-b border-border/40 hover:bg-muted/30">
                                <span class="text-muted-foreground">@row.Label</span>
                                <span class="font-medium text-right font-zodiac tracking-wide">@row.Value</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Panel: Zata Wheels -->
            <div class="lg:col-span-7 rounded-lg border border-border bg-card text-card-foreground shadow-sm aspect-auto flex flex-col items-center justify-center p-6 pb-2">
                <div class="flex flex-row flex-wrap justify-around w-full gap-4">
                    <AstroWheel Title="ရာသီ (Rasi)" Houses="@result.RasiHouses" />
                    <AstroWheel Title="နဝင်း (Navamsa)" Houses="@result.NavamsaHouses" />
                    <AstroWheel Title="ဒြေက္ကဏ (Drekkana)" Houses="@result.DrekkanaHouses" />
                </div>
                 <p class="text-xs text-muted-foreground mt-4 text-center">Charts are rendered dynamically based on the ancient Surya Siddhanta method.</p>
            </div>

        </div>

        <!-- Planetary Positions Table -->
        <div class="rounded-lg border border-border bg-card text-card-foreground shadow-sm">
            <div class="p-4">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
                        <i class="fa-solid fa-globe text-primary text-sm"></i>
                    </div>
                    <h3 class="font-semibold">Detailed Planetary Status</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-border bg-muted/20">
                                <th class="text-left py-3 px-4 text-muted-foreground font-medium rounded-tl-md">Planet (ဂြိုဟ်)</th>
                                <th class="text-left py-3 px-4 text-muted-foreground font-medium">Position (စံ)</th>
                                <th class="text-left py-3 px-4 text-muted-foreground font-medium">Navamsa Sign (နဝင်း)</th>
                                <th class="text-left py-3 px-4 text-muted-foreground font-medium rounded-tr-md">Status (ဥစ် / နိစ်)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var planet in result.DetailedPlanets)
                            {
                                <tr class="border-b border-border/50 hover:bg-muted/50 transition-colors">
                                    <td class="py-3 px-4 font-medium flex items-center gap-2">
                                        <i class="fa-solid fa-circle text-[8px] text-primary/70"></i>
                                        @planet.Planet
                                    </td>
                                    <td class="py-3 px-4 text-muted-foreground">@planet.Position</td>
                                    <td class="py-3 px-4 text-muted-foreground">@planet.Navamsa</td>
                                    <td class="py-3 px-4 text-muted-foreground font-medium">@planet.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <BhavaResults Rows="result.HouseCusps" />
        <TraditionalResults Indicators="result.TraditionalIndicators" />

        @if (result.Dasa is not null)
        {
            <DasaResults Result="result.Dasa" />
        }
        <BoResults Rows="result.BoCalendar" />
        <HoroscopeGuide />
    </div>
}

<!-- Footer -->
<footer class="no-print mt-16 mb-8 text-center text-sm text-muted-foreground">
    <div class="flex items-center justify-center gap-2 mb-2">
        <i class="fa-solid fa-star text-primary/50 text-xs"></i>
        <span>Powered by Surya Siddhanta (Makaranta) System</span>
        <i class="fa-solid fa-star text-primary/50 text-xs"></i>
    </div>
    <p>Myanmar Astro Horo — Open Source Traditional Astrological Calculator</p>
</footer>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out forwards;
    }
</style>

@code {
    private AstroInputModel inputModel = new();
    private AstroResultModel? result;
    private bool isCalculating;
    private string? calculationError;
    private IReadOnlyList<CityLocation> legacyCities = [];
    private IReadOnlyList<SavedHoroscope> savedRecords = [];
    private string selectedRecordId = "";

    private string _selectedCity = "Yangon";
    private string SelectedCity
    {
        get => _selectedCity;
        set
        {
            _selectedCity = value;
            if (int.TryParse(value, out var cityId))
            {
                var city = legacyCities.FirstOrDefault(item => item.Id == cityId);
                if (city is not null)
                {
                    SetCityCoordinates(city);
                }
                return;
            }
            SetCityCoordinates(value);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        legacyCities = await CityDirectory.GetLegacyCitiesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        savedRecords = await SavedHoroscopes.LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void SetCityCoordinates(CityLocation city)
    {
        inputModel.Latitude = city.Latitude;
        inputModel.Longitude = city.Longitude;
        inputModel.StandardTimeOffset = city.UtcOffset;
        inputModel.LocationName = $"{city.Name}, {city.Country}";
    }

    private void SetCityCoordinates(string city)
    {
        switch (city)
        {
            case "Yangon":
                inputModel.Latitude = 16.8661;
                inputModel.Longitude = 96.1951;
                inputModel.LocationName = "Yangon";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Mandalay":
                inputModel.Latitude = 21.9588;
                inputModel.Longitude = 96.0891;
                inputModel.LocationName = "Mandalay";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Naypyidaw":
                inputModel.Latitude = 19.7633;
                inputModel.Longitude = 96.0785;
                inputModel.LocationName = "Naypyidaw";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Bagan":
                inputModel.Latitude = 21.1717;
                inputModel.Longitude = 94.8585;
                inputModel.LocationName = "Bagan";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Taunggyi":
                inputModel.Latitude = 20.7891;
                inputModel.Longitude = 97.0378;
                inputModel.LocationName = "Taunggyi";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Mawlamyine":
                inputModel.Latitude = 16.4905;
                inputModel.Longitude = 97.6286;
                inputModel.LocationName = "Mawlamyine";
                inputModel.StandardTimeOffset = 6.5;
                break;
            case "Custom":
                inputModel.LocationName = "Custom location";
                inputModel.StandardTimeOffset = 6.5;
                break;
        }
    }

    private async Task CalculateHoroscope()
    {
        isCalculating = true;
        calculationError = null;
        StateHasChanged();

        try
        {
            result = await AstroService.CalculateAstroAsync(inputModel);
        }
        catch (ArgumentOutOfRangeException)
        {
            result = null;
            calculationError = "Please enter a valid date, time, latitude, and longitude.";
        }
        catch (ArgumentException)
        {
            result = null;
            calculationError = "Please enter a valid date, time, latitude, and longitude.";
        }
        finally
        {
            isCalculating = false;
            StateHasChanged();
        }
    }

    private async Task PrintResults() => await JS.InvokeVoidAsync("window.print");

    private async Task SaveCurrent()
    {
        savedRecords = await SavedHoroscopes.SaveAsync(inputModel);
        selectedRecordId = savedRecords[0].Id;
    }

    private async Task LoadSaved()
    {
        var record = savedRecords.FirstOrDefault(item => item.Id == selectedRecordId);
        if (record is null) return;
        inputModel = record.Input;
        await CalculateHoroscope();
    }

    private async Task DeleteSaved()
    {
        savedRecords = await SavedHoroscopes.DeleteAsync(selectedRecordId);
        selectedRecordId = "";
    }

    private static string SavedLabel(SavedHoroscope record) => $"{(string.IsNullOrWhiteSpace(record.Input.Name) ? record.Input.LocationName : record.Input.Name)} — {record.Input.Day:00}/{record.Input.Month:00}/{record.Input.Year:0000} {record.Input.Hour:00}:{record.Input.Minute:00}";
}
