@if (Result.CurrentMajor is not null && Result.CurrentSub is not null)
{
    <section class="rounded-lg border border-border bg-card text-card-foreground shadow-sm">
        <div class="p-4 border-b border-border bg-muted/20">
            <h3 class="font-semibold flex items-center gap-2"><i class="fa-solid fa-hourglass-half text-primary"></i> ဒသါကာလ (Dasa)</h3>
            <p class="mt-1 text-sm text-muted-foreground">မွေးလ၏ နက္ခတ်တည်နေရာမှ စတင်တွက်သော ရိုးရာကာလအစဉ် ဖြစ်ပါသည်။</p>
        </div>
        <div class="p-4 grid gap-4 md:grid-cols-2">
            <div class="rounded-md bg-primary/5 p-3"><p class="text-xs text-muted-foreground">လက်ရှိ မဟာဒသါ</p><p class="font-semibold">@Lord(Result.CurrentMajor.Lord)</p><p class="text-sm text-muted-foreground">@Date(Result.CurrentMajor.Start) – @Date(Result.CurrentMajor.End)</p></div>
            <div class="rounded-md bg-primary/5 p-3"><p class="text-xs text-muted-foreground">လက်ရှိ အန္တရဒသါ</p><p class="font-semibold">@Lord(Result.CurrentSub.Lord)</p><p class="text-sm text-muted-foreground">@Date(Result.CurrentSub.Start) – @Date(Result.CurrentSub.End)</p></div>
        </div>
        <details class="mx-4 mb-4 rounded-md border border-border/70 p-3">
            <summary class="cursor-pointer text-sm font-medium">မဟာဒသါနှင့် အန္တရဒသါ အစဉ်ကြည့်ရန်</summary>
            <div class="mt-3 grid gap-4 lg:grid-cols-2">
                <DasaTable Title="မဟာဒသါ" Periods="Result.MajorPeriods" />
                <DasaTable Title="အန္တရဒသါ" Periods="Result.SubPeriods" />
            </div>
        </details>
    </section>
}

@code {
    [Parameter, EditorRequired] public DasaResult Result { get; set; } = new();
    private static readonly string[] Months = ["", "ဇန်နဝါရီ", "ဖေဖော်ဝါရီ", "မတ်", "ဧပြီ", "မေ", "ဇွန်", "ဇူလိုင်", "ဩဂုတ်", "စက်တင်ဘာ", "အောက်တိုဘာ", "နိုဝင်ဘာ", "ဒီဇင်ဘာ"];
    private static string Date(DateOnly date) => $"{Myanmar(date.Day)} {Months[date.Month]} {Myanmar(date.Year)}";
    private static string Lord(string lord) => lord switch { "Ketu" => "ကိတ်တု", "Venus" => "သောကြာ", "Sun" => "နေ", "Moon" => "လ", "Mars" => "အင်္ဂါ", "Rahu" => "ရာဟု", "Jupiter" => "ကြာသပတေး", "Saturn" => "စနေ", "Mercury" => "ဗုဒ္ဓဟူး", _ => lord };
    private static string Myanmar(int number) => string.Concat(number.ToString().Select(digit => "၀၁၂၃၄၅၆၇၈၉"[digit - '0']));
}
